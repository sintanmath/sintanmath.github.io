{
  "description": "EML 单算子测试集。eml(x, y) = exp(x) - ln(y)",
  "expressionSchema": {
    "num":  "{ type: 'num', value: <number> }  —— 精确整数",
    "e":    "{ type: 'e' }                      —— 欧拉数 e",
    "ln0":  "{ type: 'ln0' }                    —— ln(0) 的符号形式（-∞）",
    "exp":  "{ type: 'exp', x: <expr> }         —— e^x",
    "ln":   "{ type: 'ln',  x: <expr> }         —— ln(x)",
    "sub":  "{ type: 'sub', a: <expr>, b: <expr> } —— a - b",
    "div":  "{ type: 'div', a: <expr>, b: <expr> } —— a / b",
    "pow":  "{ type: 'pow', a: <expr>, b: <expr> } —— a^b（b=Div(1,n) 会渲染为根式）",
    "neg":  "{ type: 'neg', a: <expr> }         —— -a",
    "pi":   "{ type: 'pi' }                     —— 圆周率 π",
    "i":    "{ type: 'i' }                      —— 虚数单位 i",
    "mul":  "{ type: 'mul', a: <expr>, b: <expr> } —— a · b",
    "add":  "{ type: 'add', a: <expr>, b: <expr> } —— a + b",
    "sin":  "{ type: 'sin', x: <expr> }            —— sin(x)",
    "cos":  "{ type: 'cos', x: <expr> }            —— cos(x)"
  },
  "testKinds": {
    "eml (默认)": "字段 x, y；对 eml(x,y) 跑 simplify 后比较 LaTeX",
    "toLatex":    "字段 expr；直接对表达式跑 toLatex 比较 LaTeX（不经过 eml）",
    "simplify":   "字段 expr；对表达式跑 deepSimplify（会加载 simplifications.json 里的规则）后比较 LaTeX"
  },
  "tests": [
    {
      "name": "eml(1, 1) = e",
      "rationale": "exp(1)=e, ln(1)=0, e-0=e",
      "x": { "type": "num", "value": 1 },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "e"
    },
    {
      "name": "eml(0, 1) = 1",
      "rationale": "exp(0)=1, ln(1)=0, 1-0=1",
      "x": { "type": "num", "value": 0 },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "1"
    },
    {
      "name": "eml(1, e) = e - 1",
      "rationale": "exp(1)=e, ln(e)=1",
      "x": { "type": "num", "value": 1 },
      "y": { "type": "e" },
      "expectedLatex": "e - 1"
    },
    {
      "name": "eml(e, 1) = e^e",
      "rationale": "exp(e) 保留, ln(1)=0",
      "x": { "type": "e" },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "e^{e}"
    },
    {
      "name": "eml(e, e) = e^e - 1",
      "rationale": "exp(e) 保留, ln(e)=1",
      "x": { "type": "e" },
      "y": { "type": "e" },
      "expectedLatex": "e^{e} - 1"
    },
    {
      "name": "eml(1, e^e) = 0",
      "rationale": "exp(1)=e, ln(e^e)=e, e-e=0",
      "x": { "type": "num", "value": 1 },
      "y": { "type": "exp", "x": { "type": "e" } },
      "expectedLatex": "0"
    },
    {
      "name": "eml(0, e^e) = 1 - e",
      "rationale": "exp(0)=1, ln(e^e)=e",
      "x": { "type": "num", "value": 0 },
      "y": { "type": "exp", "x": { "type": "e" } },
      "expectedLatex": "1 - e"
    },
    {
      "name": "eml(e^e, 1) = e^{e^e}",
      "rationale": "exp(e^e) 保留, ln(1)=0",
      "x": { "type": "exp", "x": { "type": "e" } },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "e^{e^{e}}"
    },
    {
      "name": "eml(1, 0) = e - ln 0",
      "rationale": "exp(1)=e, ln(0)=ln0 保留, e-ln0 不能再化简",
      "x": { "type": "num", "value": 1 },
      "y": { "type": "num", "value": 0 },
      "expectedLatex": "e - \\ln 0"
    },
    {
      "name": "eml(0, 0) = 1 - ln 0",
      "rationale": "exp(0)=1, ln(0)=ln0",
      "x": { "type": "num", "value": 0 },
      "y": { "type": "num", "value": 0 },
      "expectedLatex": "1 - \\ln 0"
    },
    {
      "name": "eml(e, 0) = e^e - ln 0",
      "rationale": "exp(e) 保留, ln(0)=ln0",
      "x": { "type": "e" },
      "y": { "type": "num", "value": 0 },
      "expectedLatex": "e^{e} - \\ln 0"
    },
    {
      "name": "eml(e - ln 0, 1) = e^e / 0",
      "rationale": "exp(e-ln0)=e^e / e^(ln0)=e^e/0; ln(1)=0",
      "x": {
        "type": "sub",
        "a": { "type": "e" },
        "b": { "type": "ln0" }
      },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "\\dfrac{e^{e}}{0}"
    },
    {
      "name": "eml(1, e^e / 0) = ln 0",
      "rationale": "exp(1)=e; ln(e^e/0)=ln(e^e)-ln(0)=e-ln0; 结果 e-(e-ln0)=ln0",
      "x": { "type": "num", "value": 1 },
      "y": {
        "type": "div",
        "a": { "type": "exp", "x": { "type": "e" } },
        "b": { "type": "num", "value": 0 }
      },
      "expectedLatex": "\\ln 0"
    },
    {
      "name": "eml(ln 0, 1) = 0",
      "rationale": "exp(ln0)=0, ln(1)=0, 0-0=0",
      "x": { "type": "ln0" },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "0"
    },
    {
      "name": "eml(ln 0, e) = -1",
      "rationale": "exp(ln0)=0, ln(e)=1, 0-1=-1",
      "x": { "type": "ln0" },
      "y": { "type": "e" },
      "expectedLatex": "-1"
    },
    {
      "name": "eml(ln 0, 2) = -ln 2",
      "rationale": "exp(ln0)=0, ln(2) 保留, 0-ln2=-ln2",
      "x": { "type": "ln0" },
      "y": { "type": "num", "value": 2 },
      "expectedLatex": "-\\ln 2"
    },
    {
      "name": "eml(-ln 2, 1) = 1/2",
      "rationale": "exp(-ln2) = 1/exp(ln2) = 1/2; ln(1)=0",
      "x": {
        "type": "neg",
        "a": { "type": "ln", "x": { "type": "num", "value": 2 } }
      },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "\\dfrac{1}{2}"
    },
    {
      "name": "eml(-1, 1) = 1/e",
      "rationale": "exp(-1) = 1/e; ln(1)=0",
      "x": { "type": "num", "value": -1 },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "\\dfrac{1}{e}"
    },
    {
      "name": "eml(-ln 2, 2) = 1/2 - ln 2",
      "rationale": "exp(-ln2)=1/2; ln(2) 保留; 无加法规则，保留为 sub",
      "x": {
        "type": "neg",
        "a": { "type": "ln", "x": { "type": "num", "value": 2 } }
      },
      "y": { "type": "num", "value": 2 },
      "expectedLatex": "\\dfrac{1}{2} - \\ln 2"
    },
    {
      "name": "eml((ln 2)/2, 1) = √2",
      "rationale": "exp(ln(2)/2) = 2^{1/2} = √2; ln(1)=0",
      "x": {
        "type": "div",
        "a": { "type": "ln", "x": { "type": "num", "value": 2 } },
        "b": { "type": "num", "value": 2 }
      },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "\\sqrt{2}"
    },
    {
      "name": "eml((ln 2)/3, 1) = ³√2",
      "rationale": "exp(ln(2)/3) = 2^{1/3} = ∛2",
      "x": {
        "type": "div",
        "a": { "type": "ln", "x": { "type": "num", "value": 2 } },
        "b": { "type": "num", "value": 3 }
      },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "\\sqrt[3]{2}"
    },
    {
      "name": "eml((ln e^e)/2, 1) = e^{e/2}",
      "rationale": "ln(e^e) 先化简为 e，再代入得 exp(e/2)，渲染为 e^{e/2}；与 √(e^e) 等价",
      "x": {
        "type": "div",
        "a": { "type": "ln", "x": { "type": "exp", "x": { "type": "e" } } },
        "b": { "type": "num", "value": 2 }
      },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "e^{\\dfrac{e}{2}}"
    },
    {
      "name": "eml(ln 0, e^e) = -e",
      "rationale": "exp(ln0)=0, ln(e^e)=e, 0-e=-e",
      "x": { "type": "ln0" },
      "y": { "type": "exp", "x": { "type": "e" } },
      "expectedLatex": "-e"
    },
    {
      "name": "eml(ln 0, 0) = -ln 0",
      "rationale": "exp(ln0)=0, ln(0)=ln0, 0-ln0=-ln0",
      "x": { "type": "ln0" },
      "y": { "type": "num", "value": 0 },
      "expectedLatex": "-\\ln 0"
    },
    {
      "name": "eml(ln 0, ln 0) 未定义，当前得 0-(-∞)",
      "rationale": "exp(ln0)=0, ln(ln0) 我们并不处理 ln 负无穷；保留 ln(ln0) 作为未化简形式",
      "x": { "type": "ln0" },
      "y": { "type": "ln0" },
      "expectedLatex": "-\\ln\\!\\left(\\ln 0\\right)"
    },
    {
      "name": "eml(e - 1, 1) = e^e / e",
      "rationale": "exp(e-1)=e^e/e^1=e^e/e; ln(1)=0",
      "x": {
        "type": "sub",
        "a": { "type": "e" },
        "b": { "type": "num", "value": 1 }
      },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "\\dfrac{e^{e}}{e}"
    },
    {
      "name": "eml(i, 1) = e^i（eml 计算不自动套欧拉公式）",
      "rationale": "eml 只做基础化简，欧拉展开留给右键菜单的化简选项",
      "x": { "type": "i" },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "e^{i}"
    },
    {
      "name": "eml(π i, 1) = e^{π i}（eml 计算不把 e^{iπ} 折叠成 -1）",
      "rationale": "同上。点化简菜单时才会折叠到 -1",
      "x": {
        "type": "mul",
        "a": { "type": "pi" },
        "b": { "type": "i" }
      },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "e^{\\pi i}"
    },
    {
      "name": "eml(-i, 1) = e^{-i}（不自动做负指数化简）",
      "rationale": "exp(-i) 保留 e^{-i}，负指数/欧拉化简留给右键菜单",
      "x": { "type": "neg", "a": { "type": "i" } },
      "y": { "type": "num", "value": 1 },
      "expectedLatex": "e^{-i}"
    },
    {
      "name": "eml(1, e - 1) = e - ln(e-1)",
      "rationale": "exp(1)=e; ln(e-1) 不能化简",
      "x": { "type": "num", "value": 1 },
      "y": {
        "type": "sub",
        "a": { "type": "e" },
        "b": { "type": "num", "value": 1 }
      },
      "expectedLatex": "e - \\ln\\!\\left(e - 1\\right)"
    },
    {
      "kind": "toLatex",
      "name": "ln(-1) 的 LaTeX 需要括号",
      "rationale": "ln 作用在负数上时必须加括号；对应之前的需求：ln-1 不能直接写",
      "expr": { "type": "ln", "x": { "type": "num", "value": -1 } },
      "expectedLatex": "\\ln\\!\\left(-1\\right)"
    },
    {
      "kind": "toLatex",
      "name": "π · i 的 LaTeX（原子相邻省略 \\cdot）",
      "rationale": "右键化简 ln(-1) 的目标形式",
      "expr": {
        "type": "mul",
        "a": { "type": "pi" },
        "b": { "type": "i" }
      },
      "expectedLatex": "\\pi i"
    },
    {
      "kind": "toLatex",
      "name": "非原子相乘使用 \\cdot",
      "rationale": "如 e^e · i 两边不都是原子",
      "expr": {
        "type": "mul",
        "a": { "type": "exp", "x": { "type": "e" } },
        "b": { "type": "i" }
      },
      "expectedLatex": "e^{e} \\cdot i"
    },
    {
      "kind": "simplify",
      "name": "深度化简：ln(-1) → π i",
      "rationale": "顶层 JSON 规则直接命中",
      "expr": { "type": "ln", "x": { "type": "num", "value": -1 } },
      "expectedLatex": "\\pi i"
    },
    {
      "kind": "simplify",
      "name": "深度化简：ln(-1)/2 → (π i)/2（子树替换）",
      "rationale": "内部子树 ln(-1) 也应被规则替换",
      "expr": {
        "type": "div",
        "a": { "type": "ln", "x": { "type": "num", "value": -1 } },
        "b": { "type": "num", "value": 2 }
      },
      "expectedLatex": "\\dfrac{\\pi i}{2}"
    },
    {
      "kind": "simplify",
      "name": "深度化简：√(-1) → i",
      "rationale": "pow(-1, 1/2) 命中 √-1 规则",
      "expr": {
        "type": "pow",
        "a": { "type": "num", "value": -1 },
        "b": {
          "type": "div",
          "a": { "type": "num", "value": 1 },
          "b": { "type": "num", "value": 2 }
        }
      },
      "expectedLatex": "i"
    },
    {
      "kind": "simplify",
      "name": "约分：(π i)/i → π",
      "rationale": "div 的约分规则：分子乘积含分母因子",
      "expr": {
        "type": "div",
        "a": {
          "type": "mul",
          "a": { "type": "pi" },
          "b": { "type": "i" }
        },
        "b": { "type": "i" }
      },
      "expectedLatex": "\\pi"
    },
    {
      "kind": "simplify",
      "name": "欧拉：e^{π i} → -1",
      "rationale": "exp(mul(pi, i)) 应展开为 cos π + i sin π = -1",
      "expr": {
        "type": "exp",
        "x": {
          "type": "mul",
          "a": { "type": "pi" },
          "b": { "type": "i" }
        }
      },
      "expectedLatex": "-1"
    },
    {
      "kind": "simplify",
      "name": "欧拉：e^{i π} → -1（乘序反过来）",
      "rationale": "无论 i 在 mul 的 a 还是 b 位置都要识别",
      "expr": {
        "type": "exp",
        "x": {
          "type": "mul",
          "a": { "type": "i" },
          "b": { "type": "pi" }
        }
      },
      "expectedLatex": "-1"
    },
    {
      "kind": "simplify",
      "name": "欧拉：e^i → cos 1 + i sin 1",
      "rationale": "exp(i) 展开为 cos(1) + i·sin(1)",
      "expr": { "type": "exp", "x": { "type": "i" } },
      "expectedLatex": "\\cos 1 + i \\sin 1"
    },
    {
      "kind": "simplify",
      "name": "欧拉合并：e^i - e^{-i} → 2i sin 1",
      "rationale": "两边分别展开后命中 (p+q)-(p-q)=2q",
      "expr": {
        "type": "sub",
        "a": { "type": "exp", "x": { "type": "i" } },
        "b": {
          "type": "exp",
          "x": { "type": "neg", "a": { "type": "i" } }
        }
      },
      "expectedLatex": "2 \\cdot i \\sin 1"
    },
    {
      "kind": "simplify",
      "name": "欧拉合并：e^i + e^{-i} → 2 cos 1",
      "rationale": "两边分别展开后命中 (p+q)+(p-q)=2p",
      "expr": {
        "type": "add",
        "a": { "type": "exp", "x": { "type": "i" } },
        "b": {
          "type": "exp",
          "x": { "type": "neg", "a": { "type": "i" } }
        }
      },
      "expectedLatex": "2 \\cos 1"
    },
    {
      "kind": "simplify",
      "name": "深度化简对 e^e 不变",
      "rationale": "e^e 没有可深化简空间，保持不变",
      "expr": { "type": "exp", "x": { "type": "e" } },
      "expectedLatex": "e^{e}"
    },
    {
      "kind": "simplify",
      "name": "cos 偶函数：cos(-1) → cos 1",
      "rationale": "cos 是偶函数，深度化简应把负号吃掉",
      "expr": { "type": "cos", "x": { "type": "num", "value": -1 } },
      "expectedLatex": "\\cos 1"
    },
    {
      "kind": "simplify",
      "name": "sin 奇函数：sin(-1) → -sin 1",
      "rationale": "sin 是奇函数",
      "expr": { "type": "sin", "x": { "type": "num", "value": -1 } },
      "expectedLatex": "-\\sin 1"
    }
  ]
}
